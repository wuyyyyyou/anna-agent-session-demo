{
  "schema": 2,
  "permissions": [],
  "required_executas": [],
  "optional_executas": [],
  "system_prompt_addendum": "Anna Agent Session Demo is a frontend playground for multi-turn agent conversations, streaming, web search, cancellation and recovery. It saves diagnostic records locally in the browser and bundles no Executa or application backend.",
  "tags": [
    "test",
    "agent",
    "session",
    "diagnostics",
    "developer-tools"
  ],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Anna Agent Session Demo",
        "default": true,
        "entry": "index.html",
        "min_size": {
          "w": 760,
          "h": 620
        },
        "default_size": {
          "w": 1120,
          "h": 760
        },
        "max_size": {
          "w": 1500,
          "h": 1100
        },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": [],
      "chat": [],
      "artifact": [],
      "llm": [
        "complete"
      ],
      "upload": [
        "negotiate",
        "confirm"
      ],
      "agent": {
        "session": {
          "auto": true,
          "fixed": null
        },
        "tools": [
          "web_search"
        ]
      },
      "fs": [],
      "storage": [],
      "prefs": [],
      "window": [
        "set_title"
      ]
    },
    "csp_overrides": {
      "script-src": [
        "'self'"
      ],
      "style-src": [
        "'self'"
      ],
      "img-src": [
        "'self'",
        "data:",
        "blob:"
      ],
      "connect-src": [
        "'self'",
        "https:",
        "blob:"
      ],
      "font-src": [
        "'self'",
        "data:"
      ]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "seed_storage": {},
    "user_id": 1
  }
}
